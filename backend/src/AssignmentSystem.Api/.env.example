# ASP.NET Core Backend Environment Variable Overrides
# Note: ASP.NET Core loads appsettings.json by default. You can override configuration
# via double-underscore environment variables when deploying:

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignmentsystem_db;Username=postgres;Password=postgres
Jwt__Issuer=AssignmentSystem
Jwt__Audience=AssignmentSystem
Jwt__Key=SUPER_SECRET_KEY_FOR_LOCAL_DEV_MUST_BE_AT_LEAST_256_BITS_LONG!
